{
  "name": "violet-obsidian-theme",
  "private": true,
  "version": "0.1.1",
  "license": "MIT",
  "scripts": {
    "build": "sass --no-source-map src/theme.scss theme.css",
    "watch": "sass --watch --no-source-map src/theme.scss theme.css",
    "test:vault": "sh scripts/create-test-vault.sh",
    "install:test": "sh scripts/install-test-theme.sh",
    "test:install": "python3 -m unittest discover -s tests -p \"test_install.py\""
  },
  "devDependencies": {
    "sass": "^1.93.2"
  },
  "dependencies": {
    "@electron/asar": "4.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
